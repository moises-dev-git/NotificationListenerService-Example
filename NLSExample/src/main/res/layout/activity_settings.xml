<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ignored Apps (comma separated package names):"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/edit_ignored_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="com.whatsapp, com.android.systemui"
        android:inputType="textMultiLine"
        android:lines="3"
        android:gravity="top"/>

    <Button
        android:id="@+id/btn_save_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Ignored Apps"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_export_json"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export Log to JSON"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_share_json"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Share Log (WhatsApp, etc.)" />

</LinearLayout>
