<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit/Filter Notifications"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edit_filter_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter by App (e.g., com.whatsapp)" />

    <EditText
        android:id="@+id/edit_filter_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter by Date (e.g., 24/06/2026)" />

    <EditText
        android:id="@+id/edit_filter_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter by Text Content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_apply_filter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Apply Filter" />

        <Button
            android:id="@+id/btn_delete_filtered"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Delete Filtered"
            android:backgroundTint="@android:color/holo_red_light" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_match_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Matches: 0"
        android:textStyle="italic" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_filtered"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
